    "Archive": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkistoi"
          }
        }
      }
    },
    "Archived (%lld)": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkistoidut (%lld)"
          }
        }
      }
    },
    "Archived chores keep their history and their place in the schedule, but don't appear on anyone's list.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkistoidut tehtävät säilyttävät historiansa ja paikkansa aikataulussa, mutta eivät näy kenenkään listalla."
          }
        }
      }
    },
    "Ask a parent to open Manage → People and show you a code.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyydä vanhempaa avaamaan Hallinta → Ihmiset ja näyttämään sinulle koodi."
          }
        }
      }
    },
    "Ask a parent to open Manage → People and show you a new code.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyydä vanhempaa avaamaan Hallinta → Ihmiset ja näyttämään sinulle uusi koodi."
          }
        }
      }
    },
    "Assign to %@": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää tehtävä: %@"
