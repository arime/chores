        }
      }
    },
    "Couldn't add %@. Check your connection and try again.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisääminen epäonnistui: %@. Tarkista verkkoyhteys ja yritä uudelleen."
