{
  "sourceLanguage": "en",
  "strings": {
    "%@ already has every chore on this day.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tämän päivän tehtävät on jo määritetty: %@."
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "ABC123": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "ABC123"
          }
        }
      }
    },
    "Active": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytössä"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää"
          }
        }
      }
    },
    "Add a child under Manage → People first.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää ensin lapsi kohdassa Hallinta → Ihmiset."
