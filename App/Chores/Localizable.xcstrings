      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää tehtävä"
          }
        }
      }
    },
    "Add parent": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää vanhempi"
          }
        }
      }
    },
    "Add some chores under Manage → Chores first.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää ensin tehtäviä kohdassa Hallinta → Tehtävät."
