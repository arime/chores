// Copy to Secrets.swift and fill in. Secrets.swift is gitignored.
//
// The anon (publishable) key is meant to be embedded in client apps — it grants
// nothing on its own, because every table is behind row level security. It is
// kept out of the repository so the *hosted* project's URL and key are not
// published, not because the key is a credential in the usual sense.
//
// Local values come from `supabase status -o env`.
// Hosted values come from the dashboard: Project Settings → API.

enum Secrets {
    static let supabaseURL = "http://127.0.0.1:54321"
    static let supabaseAnonKey = "paste-your-anon-key-here"
}
