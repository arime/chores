// Copy to Secrets.swift and fill in. Secrets.swift is gitignored.
//
// The anon (publishable) key is meant to be embedded in client apps — it grants
// nothing on its own, because every table is behind row level security. It is
// kept out of the repository so the *hosted* project's URL and key are not
// published, not because the key is a credential in the usual sense.
//
// Which of the two AppEnvironment picks:
//
//   Debug build (⌘R to a simulator or a tethered phone) → Local
//   Debug build with -hosted in the scheme's arguments  → Hosted
//   Release build (archive, TestFlight, ⌘R in Release)  → Hosted, always
//
// Local uses the Mac's Bonjour name rather than 127.0.0.1 so that a phone on the
// same Wi-Fi can reach the stack too — loopback would mean the phone itself.
// Find yours with `scutil --get LocalHostName` and append ".local". The name
// follows the machine; a DHCP address does not.
//
// Local values come from `supabase status -o env`.
// Hosted values come from the dashboard: Project Settings → API.

enum Secrets {
    enum Local {
        static let supabaseURL = "http://Work-Mac.local:54321"
        static let supabaseAnonKey = "paste-your-local-anon-key-here"
    }

    enum Hosted {
        static let supabaseURL = "https://your-project-ref.supabase.co"
        static let supabaseAnonKey = "paste-your-hosted-anon-key-here"
    }
}
