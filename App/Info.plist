<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE is still YES).
  It exists for the ATS exception below, which has no INFOPLIST_KEY_
  build-setting equivalent because it is a nested dictionary.

  It sits beside the project rather than inside Chores/ so the file-system
  synchronized folder does not also copy it into the bundle as a resource.
  PrivacyInfo.xcprivacy is the opposite case and lives inside Chores/.
-->
<plist version="1.0">
<dict>
	<!--
	  Export compliance. The app's only encryption is the HTTPS it speaks to
	  Supabase, which is the exemption every app gets for using the system's own
	  TLS. Declaring it here answers the question once; leaving it out means
	  answering it by hand in App Store Connect for every single build.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>NSAppTransportSecurity</key>
	<dict>
		<!--
		  Debug builds talk to the Supabase stack running on the developer's Mac
		  over plain HTTP. This permits cleartext to local-network names only
		  (.local and loopback) — never to arbitrary hosts, unlike
		  NSAllowsArbitraryLoads. The hosted project is HTTPS and unaffected.
		-->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
